# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / local config (never commit) ---
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/

# --- Project artifacts (large / generated) ---
# Datasets: everything under data/raw + data/processed is acquired locally
# (documentation lives in docs/dataset/ and DATASET.md; only data/splits
# keeps a placeholder so the directory exists in a fresh clone).
data/raw/*
data/processed/*
data/splits/*
!data/splits/.gitkeep

# Models & checkpoints
models/*
!models/.gitkeep
!models/baseline/
!models/baseline/README.md
*.pt
*.pth
*.onnx
*.engine
*.ckpt

# Generated outputs (regenerable images stay local; their index/README
# documents stay tracked)
examples/output/*
!examples/output/.gitkeep
reports/figures/*
!reports/figures/.gitkeep
reports/baseline_samples/*.jpg
reports/phase2_core50_samples/*.png
reports/phase4_samples/*.jpg
reports/phase5_nic/plots/*.png
reports/phase3_samples/*
!reports/phase3_samples/.gitkeep
reports/phase6_analysis/examples/
reports/baseline_detections.json
runs/
wandb/
lightning_logs/
mlruns/

# Logs
*.log
logs/
